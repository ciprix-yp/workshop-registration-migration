# Google Sheets API Configuration
# How to get credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create new project or select existing
# 3. Enable Google Sheets API
# 4. Create Service Account (IAM & Admin → Service Accounts)
# 5. Download JSON key file
# 6. Share your Google Sheet with the service account email

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Workshop 1: BIZZ.CLUB Satu Mare
NEXT_PUBLIC_SHEET_ID_BIZZ_CLUB_SM=your-google-sheet-id
NEXT_PUBLIC_STRIPE_MEMBER_BIZZ_CLUB_SM=https://buy.stripe.com/your-member-link
NEXT_PUBLIC_STRIPE_STANDARD_BIZZ_CLUB_SM=https://buy.stripe.com/your-standard-link
N8N_WEBHOOK_URL_BIZZ_CLUB_SM=https://your-n8n-instance/webhook/your-webhook-id

# n8n Webhook Authentication (shared)
N8N_WEBHOOK_USER=your-webhook-user
N8N_WEBHOOK_PASS=your-webhook-password

# Future workshops (template):
# NEXT_PUBLIC_SHEET_ID_WORKSHOP_NAME=
# NEXT_PUBLIC_STRIPE_MEMBER_WORKSHOP_NAME=
# NEXT_PUBLIC_STRIPE_STANDARD_WORKSHOP_NAME=
# N8N_WEBHOOK_URL_WORKSHOP_NAME=
